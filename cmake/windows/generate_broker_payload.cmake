# Called after the broker has been built (and, for releases, signed).
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT EXISTS "${INPUT}")
  message(FATAL_ERROR "A built broker and resource output path are required")
endif()
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
set(payload "${directory}/broker.bin")
set(metadata "${directory}/broker.sha256")
file(COPY_FILE "${INPUT}" "${payload}" ONLY_IF_DIFFERENT)
file(SIZE "${payload}" bytes)
if(bytes LESS 1 OR bytes GREATER 67108864)
  message(FATAL_ERROR "Invalid embedded broker size")
endif()
file(SHA256 "${payload}" digest)
file(WRITE "${metadata}" "${digest}")
# RC accepts forward slashes, including paths containing spaces.
file(TO_CMAKE_PATH "${payload}" payload)
file(TO_CMAKE_PATH "${metadata}" metadata)
file(WRITE "${OUTPUT}" "51001 RCDATA \"${payload}\"\n51002 RCDATA \"${metadata}\"\n")
